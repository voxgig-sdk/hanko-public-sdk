                orig: "domain"
                reqd: true
                type: "`$STRING`"
              }
            ]
          }
          contract: {
            id: "GET /saml/provider"
            json: "{\"operationId\":\"get-saml-provider\",\"parameters\":[{\"description\":\"Fully qualified domain name for which a SAML service provider is registered\",\"in\":\"query\",\"name\":\"domain\",\"required\":true,\"schema\":{\"format\":\"hostname\",\"type\":\"string\"}}],\"protocol\":\"http\",\"responses\":{\"200\":{\"content\":{\"application/json\":{\"schema\":{\"additionalProperties\":false,\"properties\":{\"attribute_map\":{\"additionalProperties\":false,\"properties\":{\"birthdate\":{\"type\":\"string\"},\"email\":{\"type\":\"string\"},\"email_verified\":{\"type\":\"string\"},\"family_name\":{\"type\":\"string\"},\"gender\":{\"type\":\"string\"},\"given_name\":{\"type\":\"string\"},\"locale\":{\"type\":\"string\"},\"middle_name\":{\"type\":\"string\"},\"name\":{\"type\":\"string\"},\"nickname\":{\"type\":\"string\"},\"phone\":{\"type\":\"string\"},\"phone_verified\":{\"type\":\"string\"},\"picture\":{\"type\":\"string\"},\"preferred_username\":{\"type\":\"string\"},\"profile\":{\"type\":\"string\"},\"updated_at\":{\"type\":\"string\"},\"website\":{\"type\":\"string\"},\"zone_info\":{\"type\":\"string\"}},\"type\":\"object\"},\"domain\":{\"example\":\"text.example\",\"format\":\"hostname\",\"readOnly\":true,\"type\":\"string\"},\"enabled\":{\"default\":true,\"readOnly\":true,\"type\":\"boolean\"},\"metadata_url\":{\"example\":\"http://idp-metadata.url\",\"format\":\"uri\",\"readOnly\":true,\"type\":\"string\"},\"name\":{\"example\":\"MySamlProvier\",\"readOnly\":true,\"type\":\"string\"},\"skip_email_verification\":{\"default\":false,\"readOnly\":true,\"type\":\"boolean\"}},\"type\":\"object\"}}},\"description\":\"OK\"},\"400\":{\"content\":{\"application/json\":{\"example\":{\"code\":400,\"message\":\"Bad Request\"},\"schema\":{\"properties\":{\"code\":{\"format\":\"int32\",\"type\":\"integer\"},\"message\":{\"type\":\"string\"}},\"required\":[\"code\",\"message\"],\"type\":\"object\"}}},\"description\":\"Bad Request\"},\"404\":{\"description\":\"Not Found\"}},\"securitySchemes\":{\"BearerTokenAuth\":{\"bearerFormat\":\"JWT\",\"scheme\":\"bearer\",\"type\":\"http\"},\"CookieAuth\":{\"in\":\"cookie\",\"name\":\"hanko\",\"type\":\"apiKey\"}},\"securitySource\":\"unspecified\"}"

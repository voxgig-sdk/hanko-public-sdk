# Entity: saml

main: kit: entity: saml: {

  alias: field: {}

  fields: [
    {
      name: "birthdate"
      req: false
      type: "`$STRING`"
    }
    {
      name: "email"
      req: false
      type: "`$STRING`"
    }
    {
      name: "email_verified"
      req: false
      type: "`$STRING`"
    }
    {
      name: "family_name"
      req: false
      type: "`$STRING`"
    }
    {
      name: "gender"
      req: false
      type: "`$STRING`"
    }
    {
      name: "given_name"
      req: false
      type: "`$STRING`"
    }
    {
      name: "locale"
      req: false
      type: "`$STRING`"
    }
    {
      name: "middle_name"
      req: false
      type: "`$STRING`"
    }
    {
      name: "name"
      req: false
      type: "`$STRING`"
    }
    {
      name: "nickname"
      req: false
      type: "`$STRING`"
    }
    {
      name: "phone"
      req: false
      type: "`$STRING`"
    }
    {
      name: "phone_verified"
      req: false
      type: "`$STRING`"
    }
    {
      name: "picture"
      req: false
      type: "`$STRING`"
    }
    {
      name: "preferred_username"
      req: false
      type: "`$STRING`"
    }
    {
      name: "profile"
      req: false
      type: "`$STRING`"
    }
    {
      name: "updated_at"
      req: false
      type: "`$STRING`"
    }
    {
      name: "website"
      req: false
      type: "`$STRING`"
    }
    {
      name: "zone_info"
      req: false
      type: "`$STRING`"
    }
  ]

  name: "saml"
  op: {
    create: {
      name: "create"
      points: [
        {
          method: "POST"
          orig: "/saml/callback"
          segments: [
            {
              lit: "saml"
            }
            {
              lit: "callback"
            }
          ]
          select: {
            "$action": "callback"
          }
          transform: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
      ]
    }
    load: {
      name: "load"
      points: [
        {
          args: {
            query: [
              {
                kind: "query"
                name: "cert_only"
                orig: "cert_only"
                reqd: false
                type: "`$BOOLEAN`"
              }
              {
                kind: "query"
                name: "domain"
                orig: "domain"
                reqd: true
                type: "`$STRING`"
              }
            ]
          }
          method: "GET"
          orig: "/saml/metadata"
          segments: [
            {
              lit: "saml"
            }
            {
              lit: "metadata"
            }
          ]
          select: {
            "$action": "metadata"
            exist: [
              "cert_only"
              "domain"
            ]
          }
          transform: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
        {
          args: {
            query: [
              {
                kind: "query"
                name: "domain"
                orig: "domain"
                reqd: true
                type: "`$STRING`"
              }
            ]
          }
          method: "GET"
          orig: "/saml/provider"
          segments: [
            {
              lit: "saml"
            }
            {
              lit: "provider"
            }
          ]
          select: {
            "$action": "provider"
            exist: [
              "domain"
            ]
          }
          transform: {
            req: "`reqdata`"
            res: "`body.attribute_map`"
          }
        }
      ]
    }
  }



}

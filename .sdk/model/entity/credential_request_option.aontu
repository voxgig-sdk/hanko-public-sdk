# Entity: credential_request_option

main: kit: entity: credential_request_option: {

  alias: field: {}

  fields: {
    allowCredentials: {
      h: "Allow Credentials"
      n: "allowCredentials"
      r: false
      t: "`$ARRAY`"
    }
    challenge: {
      fo: "base64url"
      h: "Challenge"
      n: "challenge"
      r: false
      t: "`$STRING`"
    }
    rpId: {
      h: "Rp Id"
      n: "rpId"
      r: false
      t: "`$STRING`"
    }
    timeout: {
      fo: "int64"
      h: "Timeout"
      n: "timeout"
      r: false
      t: "`$INTEGER`"
    }
    userVerification: {
      h: "User Verification"
      n: "userVerification"
      r: false
      t: "`$STRING`"
    }
    user_id: {
      fo: "uuid4"
      h: "User Id"
      n: "user_id"
      r: false
      sh: "The ID of the user on whose behalf WebAuthn login should be performed"
      t: "`$STRING`"
    }
  }

  name: "credential_request_option"
  op: {
    create: {
      name: "create"
      points: [
        {
          bf: [
            "user_id"
          ]
          co: {
            id: "POST /webauthn/login/initialize"
            source: "openapi3"
            version: 2
          }
          m: "POST"
          o: "/webauthn/login/initialize"
          rs: {
            kind: "json"
            media: "application/json"
          }
          s: [
            {
              lit: "webauthn"
            }
            {
              lit: "login"
            }
            {
              lit: "initialize"
            }
          ]
          t: {
            req: "`reqdata`"
            res: "`body.publicKey`"
          }
        }
      ]
    }
  }



}

# Entity: token

main: kit: entity: token: {

  alias: field: {}

  fields: [
    {
      format: "base64url"
      name: "value"
      req: false
      type: "`$STRING`"
    }
  ]

  name: "token"
  op: {
    create: {
      name: "create"
      points: [
        {
          method: "POST"
          orig: "/token"
          segments: [
            {
              lit: "token"
            }
          ]
          transform: {
            req: "`reqdata`"
            res: "`body.user_id`"
          }
        }
      ]
    }
  }



}

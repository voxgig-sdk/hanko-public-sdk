# Entity: password

main: kit: entity: password: {

  alias: field: {}

  fields: [
    {
      name: "password"
      req: true
      type: "`$STRING`"
    }
    {
      name: "user_id"
      req: true
      type: "`$STRING`"
    }
  ]

  name: "password"
  op: {
    create: {
      name: "create"
      points: [
        {
          method: "POST"
          orig: "/password/login"
          parts: [
            "password"
            "login"
          ]
          select: {
            "$action": "login"
          }
          transform: {
            req: {
              password: "`reqdata`"
            }
            res: "`body`"
          }
        }
      ]
    }
    update: {
      name: "update"
      points: [
        {
          method: "PUT"
          orig: "/password"
          parts: [
            "password"
          ]
          transform: {
            req: {
              password: "`reqdata`"
            }
            res: "`body`"
          }
        }
      ]
    }
  }



}

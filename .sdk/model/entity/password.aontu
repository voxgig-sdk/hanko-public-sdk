# Entity: password

main: kit: entity: password: {

  alias: field: {}

  fields: {
    password: {
      h: "Password"
      n: "password"
      r: true
      sh: "The actual password, its `minLength` defaults to 8 but can be [configured](https://github.com/teamhanko/hanko/blob/main/backend/docs/Config.md#hanko-backend-config) through the `password.min_password_length` option."
      t: "`$STRING`"
    }
    user_id: {
      fo: "uuid4"
      h: "User Id"
      n: "user_id"
      r: true
      sh: "The ID of the user to create/set a password for"
      t: "`$STRING`"
    }
  }

  name: "password"
  op: {
    create: {
      name: "create"
      points: [
        {
          bf: [
            "password"
            "user_id"
          ]
          co: {
            id: "POST /password/login"
            source: "openapi3"
            version: 2
          }
          m: "POST"
          o: "/password/login"
          q: {
            "$action": "login"
          }
          s: [
            {
              lit: "password"
            }
            {
              lit: "login"
            }
          ]
          t: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
      ]
    }
    update: {
      name: "update"
      points: [
        {
          bf: [
            "password"
            "user_id"
          ]
          co: {
            id: "PUT /password"
            source: "openapi3"
            version: 2
          }
          m: "PUT"
          o: "/password"
          s: [
            {
              lit: "password"
            }
          ]
          t: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
      ]
    }
  }



}

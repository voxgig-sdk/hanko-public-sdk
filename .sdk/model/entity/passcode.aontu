# Entity: passcode

main: kit: entity: passcode: {

  alias: field: {}

  fields: {
    code: {
      h: "Code"
      n: "code"
      r: false
      sh: "The actual passcode from the email sent to the user during initialization, a string of 6 decimal digits"
      t: "`$STRING`"
    }
    email_id: {
      h: "Email Id"
      n: "email_id"
      r: false
      sh: "The ID of the email address"
      t: "`$STRING`"
    }
    id: {
      h: "Id"
      n: "id"
      r: false
      sh: "The ID of the passcode"
      t: "`$STRING`"
    }
    user_id: {
      h: "User Id"
      n: "user_id"
      r: true
      sh: "The ID of the user"
      t: "`$STRING`"
    }
  }

  id: {
    field: "id"
    name: "id"
  }

  name: "passcode"
  op: {
    create: {
      name: "create"
      points: [
        {
          co: {
            id: "POST /passcode/login/finalize"
            source: "openapi3"
            version: 2
          }
          m: "POST"
          o: "/passcode/login/finalize"
          s: [
            {
              lit: "passcode"
            }
            {
              lit: "login"
            }
            {
              lit: "finalize"
            }
          ]
          t: {
            req: "`reqdata`"
            res: "`body.id`"
          }
        }
        {
          co: {
            id: "POST /passcode/login/initialize"
            source: "openapi3"
            version: 2
          }
          m: "POST"
          o: "/passcode/login/initialize"
          s: [
            {
              lit: "passcode"
            }
            {
              lit: "login"
            }
            {
              lit: "initialize"
            }
          ]
          t: {
            req: "`reqdata`"
            res: "`body.id`"
          }
        }
      ]
    }
  }



}

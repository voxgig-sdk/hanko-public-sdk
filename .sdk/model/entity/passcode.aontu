# Entity: passcode

main: kit: entity: passcode: {

  alias: field: {}

  fields: {
    code: {
      h: "Code"
      n: "code"
      r: false
      sh: "The actual passcode from the email sent to the user during initialization, a string of 6 decimal digits"
      t: "`$STRING`"
    }
    created_at: {
      fo: "date-time"
      h: "Created At"
      n: "created_at"
      r: false
      sh: "Time of creation of the passcode"
      t: "`$STRING`"
    }
    email_id: {
      fo: "uuid4"
      h: "Email Id"
      n: "email_id"
      r: false
      sh: "The ID of the email address"
      t: "`$STRING`"
    }
    id: {
      fo: "uuid4"
      h: "Id"
      n: "id"
      r: false
      sh: "The ID of the passcode"
      t: "`$STRING`"
    }
    ttl: {
      h: "Ttl"
      n: "ttl"
      r: false
      sh: "Lifespan of a passcode in seconds"
      t: "`$INTEGER`"
    }
    user_id: {
      fo: "uuid4"
      h: "User Id"
      n: "user_id"
      r: true
      sh: "The ID of the user"
      t: "`$STRING`"
    }
  }

  id: {
    field: "id"
    name: "id"
  }

  name: "passcode"
  op: {
    create: {
      name: "create"
      points: [
        {
          bf: [
            "code"
            "id"
          ]
          co: {
            id: "POST /passcode/login/finalize"
            source: "openapi3"
            version: 2
          }
          m: "POST"
          o: "/passcode/login/finalize"
          rs: {
            kind: "json"
            media: "application/json"
          }
          s: [
            {
              lit: "passcode"
            }
            {
              lit: "login"
            }
            {
              lit: "finalize"
            }
          ]
          t: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
        {
          bf: [
            "email_id"
            "user_id"
          ]
          co: {
            id: "POST /passcode/login/initialize"
            source: "openapi3"
            version: 2
          }
          m: "POST"
          o: "/passcode/login/initialize"
          rs: {
            kind: "json"
            media: "application/json"
          }
          s: [
            {
              lit: "passcode"
            }
            {
              lit: "login"
            }
            {
              lit: "initialize"
            }
          ]
          t: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
      ]
    }
  }



}

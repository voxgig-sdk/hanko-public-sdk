# Entity: third_party

main: kit: entity: third_party: {

  alias: field: {}

  name: "third_party"
  op: {
    load: {
      name: "load"
      points: [
        {
          args: {
            query: [
              {
                kind: "query"
                name: "code"
                orig: "code"
                reqd: false
                type: "`$STRING`"
              }
              {
                kind: "query"
                name: "error"
                orig: "error"
                reqd: false
                type: "`$STRING`"
              }
              {
                kind: "query"
                name: "error_description"
                orig: "error_description"
                reqd: false
                type: "`$STRING`"
              }
              {
                kind: "query"
                name: "state"
                orig: "state"
                reqd: true
                type: "`$STRING`"
              }
            ]
          }
          contract: {
            id: "GET /thirdparty/callback"
            json: "{\"operationId\":\"thirdPartyCallback\",\"parameters\":[{\"description\":\"The authorization code that can be exchanged for an access token and to retrieve user provider data\\n\",\"in\":\"query\",\"name\":\"code\",\"schema\":{\"type\":\"string\"}},{\"description\":\"The state\",\"in\":\"query\",\"name\":\"state\",\"required\":true,\"schema\":{\"type\":\"string\"}},{\"description\":\"An error returned from the third party provider\\n\",\"in\":\"query\",\"name\":\"error\",\"schema\":{\"type\":\"string\"}},{\"description\":\"The description of the error that occurred (if any)\",\"in\":\"query\",\"name\":\"error_description\",\"schema\":{\"type\":\"string\"}}],\"protocol\":\"http\",\"responses\":{\"307\":{\"description\":\"Redirect to requested redirect URL or to configured site redirect URL\",\"headers\":{\"Location\":{\"description\":\"Redirect to the URL requested via `redirect_to` query parameter during third party\\nprovider login via [`/auth`](#tag/Third-Party/operation/thirdPartyAuth) endpoint on success. On error,\\nredirect to the `third_party.error_redirect_url` set in the backend\\n[configuration](https://github.com/teamhanko/hanko/blob/main/backend/docs/Config.md#hanko-backend-config).\\nError details are provided in the location URL in the form of `error` and `error_description`\\nquery params.\\n\",\"schema\":{\"type\":\"string\"}},\"Set-Cookie\":{\"description\":\"Present only on successful callback. Contains the JSON Web Token (JWT) that must be provided to protected endpoints.\\nCookie attributes (e.g. domain) can be set via [configuration](https://github.com/teamhanko/hanko/blob/main/backend/docs/Config.md#hanko-backend-config) option `session.cookie`.\\n\",\"schema\":{\"description\":\"Value `<JWT>` is a [JSON Web Token](https://www.rfc-editor.org/rfc/rfc7519.html)\",\"example\":\"hanko=<JWT>; Path=/; HttpOnly\",\"type\":\"string\"}},\"X-Auth-Token\":{\"description\":\"Present only on successful callback and when enabled via [configuration](https://github.com/teamhanko/hanko/blob/main/backend/docs/Config.md#hanko-backend-config) option `session.enable_auth_token_header`\\nfor purposes of cross-domain communication between client and Hanko API.\\n\",\"schema\":{\"description\":\"Enable via [configuration](https://github.com/teamhanko/hanko/blob/main/backend/docs/Config.md#hanko-backend-config) option `session.enable_auth_token_header`\\nfor purposes of cross-domain communication between client and Hanko API.\\n\",\"externalDocs\":{\"url\":\"https://github.com/teamhanko/hanko/blob/main/backend/docs/Config.md#hanko-backend-config\"},\"format\":\"JWT\",\"type\":\"string\"}}}}},\"securitySchemes\":{\"BearerTokenAuth\":{\"bearerFormat\":\"JWT\",\"scheme\":\"bearer\",\"type\":\"http\"},\"CookieAuth\":{\"in\":\"cookie\",\"name\":\"hanko\",\"type\":\"apiKey\"}},\"securitySource\":\"unspecified\"}"
            source: "openapi3"
            version: 1
          }
          method: "GET"
          orig: "/thirdparty/callback"
          segments: [
            {
              lit: "thirdparty"
            }
            {
              lit: "callback"
            }
          ]
          select: {
            exist: [
              "code"
              "error"
              "error_description"
              "state"
            ]
          }
          transform: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
        {
          args: {
            query: [
              {
                kind: "query"
                name: "provider"
                orig: "provider"
                reqd: true
                type: "`$STRING`"
              }
              {
                kind: "query"
                name: "redirect_to"
                orig: "redirect_to"
                reqd: true
                type: "`$STRING`"
              }
            ]
          }
          contract: {
            id: "GET /thirdparty/auth"
            json: "{\"operationId\":\"thirdPartyAuth\",\"parameters\":[{\"description\":\"The name of the third party provider to log in with. Only providers enabled in the\\n[configuration](https://github.com/teamhanko/hanko/blob/main/backend/docs/Config.md#hanko-backend-config)\\nvia the `thirdparty.providers` option can be used. Requesting an unsupported provider results in a\\nredirect with error details in the location query.\\n\",\"in\":\"query\",\"name\":\"provider\",\"required\":true,\"schema\":{\"enum\":[\"google\",\"github\"],\"type\":\"string\"}},{\"description\":\"Base64url encoded string representing the URL the\\n[`/callback`](#tag/Third-Party/operation/thirdPartyCallback) eventually redirects to after successful login\\nwith the third party provider. It must match one of the allowed redirect URLs set in the backend\\n[configuration](https://github.com/teamhanko/hanko/blob/main/backend/docs/Config.md#hanko-backend-config)\\nthrough the `third_party.allowed_redirect_urls`.\\n\",\"in\":\"query\",\"name\":\"redirect_to\",\"required\":true,\"schema\":{\"format\":\"base64url\",\"type\":\"string\"}}],\"protocol\":\"http\",\"responses\":{\"307\":{\"description\":\"Redirect to third party provider\",\"headers\":{\"Location\":{\"description\":\"Redirect to the third party provider on success. On error, redirects to the `Referer`. If `Referer` is\\nnot present, redirects to the `third_party.error_redirect_url` set in the backend\\n[configuration](https://github.com/teamhanko/hanko/blob/main/backend/docs/Config.md#hanko-backend-config).\\nError details are provided in the location URL in the form of `error` and `error_description`\\nquery params.\\n\",\"schema\":{\"type\":\"string\"}}}}},\"securitySchemes\":{\"BearerTokenAuth\":{\"bearerFormat\":\"JWT\",\"scheme\":\"bearer\",\"type\":\"http\"},\"CookieAuth\":{\"in\":\"cookie\",\"name\":\"hanko\",\"type\":\"apiKey\"}},\"securitySource\":\"unspecified\"}"
            source: "openapi3"
            version: 1
          }
          method: "GET"
          orig: "/thirdparty/auth"
          segments: [
            {
              lit: "thirdparty"
            }
            {
              lit: "auth"
            }
          ]
          select: {
            exist: [
              "provider"
              "redirect_to"
            ]
          }
          transform: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
      ]
    }
  }



}

# Entity: credential_creation_option

main: kit: entity: credential_creation_option: {

  alias: field: {}

  fields: [
    {
      name: "attestation"
      req: false
      type: "`$STRING`"
    }
    {
      name: "authenticatorSelection"
      req: false
      type: "`$OBJECT`"
    }
    {
      name: "challenge"
      req: false
      type: "`$STRING`"
    }
    {
      name: "pubKeyCredParams"
      req: false
      type: "`$ARRAY`"
    }
    {
      name: "rp"
      req: false
      type: "`$OBJECT`"
    }
    {
      name: "timeout"
      req: false
      type: "`$INTEGER`"
    }
    {
      name: "user"
      req: false
      type: "`$OBJECT`"
    }
  ]

  name: "credential_creation_option"
  op: {
    create: {
      name: "create"
      points: [
        {
          method: "POST"
          orig: "/webauthn/registration/initialize"
          parts: [
            "webauthn"
            "registration"
            "initialize"
          ]
          transform: {
            req: "`reqdata`"
            res: "`body.publicKey`"
          }
        }
      ]
    }
  }



}

# Entity: session_management

main: kit: entity: session_management: {

  alias: field: {}

  fields: [
    {
      name: "amr"
      req: false
      short: "Authentication Method References, JSON array of strings that are identifiers for authentication methods used in the authentication."
      type: "`$ARRAY`"
    }
    {
      name: "audience"
      req: false
      short: "The intended audience of the token."
      type: "`$ARRAY`"
    }
    {
      name: "email"
      req: false
      short: "Data about the email address associated with the token's subject, if available."
      type: "`$OBJECT`"
    }
    {
      format: "date-time"
      name: "expiration"
      req: true
      short: "The timestamp indicating when the token will expire."
      type: "`$STRING`"
    }
    {
      format: "date-time"
      name: "issued_at"
      req: false
      short: "The timestamp indicating when the token was issued."
      type: "`$STRING`"
    }
    {
      name: "issuer"
      req: false
      short: "The entity that issued the token."
      type: "`$STRING`"
    }
    {
      name: "session_id"
      req: true
      short: "The unique identifier for the session associated with this token."
      type: "`$STRING`"
    }
    {
      format: "JWT"
      name: "session_token"
      req: true
      short: "The session token (JWT) to validate"
      type: "`$STRING`"
    }
    {
      name: "subject"
      req: true
      short: "The unique identifier of the token's subject."
      type: "`$ANY`"
    }
  ]

  name: "session_management"
  op: {
    create: {
      name: "create"
      points: [
        {
          method: "POST"
          orig: "/sessions/validate"
          segments: [
            {
              lit: "sessions"
            }
            {
              lit: "validate"
            }
          ]
          transform: {
            req: "`reqdata`"
            res: "`body.claims`"
          }
        }
      ]
    }
    load: {
      name: "load"
      points: [
        {
          method: "GET"
          orig: "/sessions/validate"
          segments: [
            {
              lit: "sessions"
            }
            {
              lit: "validate"
            }
          ]
          transform: {
            req: "`reqdata`"
            res: "`body.claims`"
          }
        }
      ]
    }
  }



}

  name: "session_management"
  op: {
    create: {
      name: "create"
      points: [
        {
          contract: {
            id: "POST /sessions/validate"
            json: "{\"parameters\":[],\"protocol\":\"http\",\"requestBody\":{\"content\":{\"application/json\":{\"schema\":{\"properties\":{\"session_token\":{\"description\":\"The session token (JWT) to validate\",\"format\":\"JWT\",\"type\":\"string\"}},\"required\":[\"session_token\"]}}}},\"responses\":{\"200\":{\"content\":{\"application/json\":{\"schema\":{\"properties\":{\"claims\":{\"description\":\"The claims extracted from a JWT.\",\"properties\":{\"amr\":{\"description\":\"Authentication Method References, JSON array of strings that are identifiers for authentication methods used in the authentication.\",\"items\":{\"description\":\"- `pwd` => password\\n- `passkey` => passkey\\n- `otp` => email passcode\\n- `ext:<provider>` => thirdparty provider, where <provider> is the internal provider ID, e.g. `ext:microsoft`\\n- `totp` => 2FA authenticator app\\n- `security_key` => 2FA security key\\n\",\"enum\":[\"pwd\",\"passkey\",\"otp\",\"ext:<provider>\",\"totp\",\"security_key\"],\"type\":\"string\"},\"type\":\"array\"},\"audience\":{\"description\":\"The intended audience of the token.\",\"items\":{\"type\":\"string\"},\"type\":\"array\"},\"email\":{\"description\":\"Data about the email address associated with the token's subject, if available.\",\"properties\":{\"address\":{\"description\":\"The actual email address.\",\"format\":\"email\",\"type\":\"string\"},\"is_primary\":{\"description\":\"Indicates whether the email address is the primary address.\",\"type\":\"boolean\"},\"is_verified\":{\"description\":\"Indicates whether the email address is verified.\",\"type\":\"boolean\"}},\"type\":\"object\"},\"expiration\":{\"description\":\"The timestamp indicating when the token will expire.\",\"format\":\"date-time\",\"type\":\"string\"},\"issued_at\":{\"description\":\"The timestamp indicating when the token was issued.\",\"format\":\"date-time\",\"type\":\"string\"},\"issuer\":{\"description\":\"The entity that issued the token.\",\"type\":\"string\"},\"session_id\":{\"allOf\":[{\"example\":\"c339547d-e17d-4ba7-8a1d-b3d5a4d17c1c\",\"format\":\"uuid4\",\"type\":\"string\"}],\"description\":\"The unique identifier for the session associated with this token.\"},\"subject\":{\"allOf\":[{\"example\":\"c339547d-e17d-4ba7-8a1d-b3d5a4d17c1c\",\"format\":\"uuid4\",\"type\":\"string\"}],\"description\":\"The unique identifier of the token's subject.\"}},\"required\":[\"subject\",\"expiration\",\"session_id\"],\"type\":\"object\"},\"expiration_time\":{\"deprecated\":true,\"description\":\"Date-time indicating the expiration of the session. Deprecated, please use `claims.expiration` instead.\",\"format\":\"date-time\",\"type\":\"string\"},\"idle_expires_at\":{\"description\":\"Timestamp (in UTC) indicating when the session will expire due to inactivity, assuming no further activity occurs before this time.\\nOnly present when idle timeout is configured. The value is capped to the JWT expiration time.\\n\",\"format\":\"date-time\",\"type\":\"string\"},\"is_valid\":{\"description\":\"Indicates whether the session is valid or not\",\"type\":\"boolean\"},\"user_id\":{\"deprecated\":true,\"description\":\"The ID of the user the session is associated with. Deprecated, please use `claims.subject` instead.\",\"format\":\"uuid4\",\"type\":\"string\"}},\"required\":[\"isValid\"]}}},\"description\":\"Session validation response\"},\"400\":{\"content\":{\"application/json\":{\"example\":{\"code\":400,\"message\":\"Bad Request\"},\"schema\":{\"properties\":{\"code\":{\"format\":\"int32\",\"type\":\"integer\"},\"message\":{\"type\":\"string\"}},\"required\":[\"code\",\"message\"],\"type\":\"object\"}}},\"description\":\"Bad Request\"},\"500\":{\"content\":{\"application/json\":{\"example\":{\"code\":500,\"message\":\"Internal Server Error\"},\"schema\":{\"properties\":{\"code\":{\"format\":\"int32\",\"type\":\"integer\"},\"message\":{\"type\":\"string\"}},\"required\":[\"code\",\"message\"],\"type\":\"object\"}}},\"description\":\"Internal server error\"}},\"securitySchemes\":{\"BearerTokenAuth\":{\"bearerFormat\":\"JWT\",\"scheme\":\"bearer\",\"type\":\"http\"},\"CookieAuth\":{\"in\":\"cookie\",\"name\":\"hanko\",\"type\":\"apiKey\"}},\"securitySource\":\"unspecified\"}"
            source: "openapi3"
            version: 1
          }
          method: "POST"
          orig: "/sessions/validate"
          segments: [

# Entity: webauthn_login

main: kit: entity: webauthn_login: {

  alias: field: {}

  fields: [
    {
      format: "base64url"
      name: "credential_id"
      req: false
      type: "`$STRING`"
    }
    {
      name: "id"
      req: false
      type: "`$STRING`"
    }
    {
      name: "rawId"
      req: false
      type: "`$STRING`"
    }
    {
      name: "response"
      req: false
      type: "`$OBJECT`"
    }
    {
      name: "type"
      req: false
      type: "`$STRING`"
    }
    {
      format: "uuid4"
      name: "user_id"
      req: false
      type: "`$STRING`"
    }
  ]

  id: {
    field: "id"
    name: "id"
  }

  name: "webauthn_login"
  op: {
    create: {
      name: "create"
      points: [
        {
          method: "POST"
          orig: "/webauthn/login/finalize"
          segments: [
            {
              lit: "webauthn"
            }
            {
              lit: "login"
            }
            {
              lit: "finalize"
            }
          ]
          transform: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
      ]
    }
  }



}

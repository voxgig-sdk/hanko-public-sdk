# Entity: hanko_configuration

main: kit: entity: hanko_configuration: {

  alias: field: {}

  fields: {
    account: {
      h: "Account"
      n: "account"
      r: false
      sh: "Controls the behavior regarding user account."
      t: "`$OBJECT`"
    }
    emails: {
      h: "Emails"
      n: "emails"
      r: false
      sh: "Controls the behavior regarding email addresses."
      t: "`$OBJECT`"
    }
    password: {
      h: "Password"
      n: "password"
      r: false
      sh: "Configuration options concerning passwords"
      t: "`$OBJECT`"
    }
  }

  name: "hanko_configuration"
  op: {
    load: {
      name: "load"
      points: [

# Entity: email

main: kit: entity: email: {

  alias: field: {}

  fields: [
    {
      name: "address"
      op: {
        list: {
          req: false
          type: "`$STRING`"
        }
      }
      req: true
      short: "The email address"
      type: "`$STRING`"
    }
    {
      name: "id"
      req: false
      short: "The ID of the email address"
      type: "`$STRING`"
    }
    {
      name: "identities"
      req: false
      type: "`$ANY`"
    }
    {
      name: "identity"
      req: false
      type: "`$ANY`"
    }
    {
      name: "is_primary"
      req: false
      short: "Indicates it's the primary email address."
      type: "`$BOOLEAN`"
    }
    {
      name: "is_verified"
      req: false
      short: "Indicated the email has been verified."
      type: "`$BOOLEAN`"
    }
  ]

  id: {
    field: "id"
    name: "id"
  }

  name: "email"
  op: {
    create: {
      name: "create"
      points: [
        {
          method: "POST"
          orig: "/emails"
          parts: [
            "emails"
          ]
          transform: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
      ]
    }
    list: {
      name: "list"
      points: [
        {
          method: "GET"
          orig: "/emails"
          parts: [
            "emails"
          ]
          transform: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
      ]
    }
    remove: {
      name: "remove"
      points: [
        {
          args: {
            params: [
              {
                example: "c339547d-e17d-4ba7-8a1d-b3d5a4d17c1c"
                kind: "param"
                name: "id"
                orig: "id"
                reqd: true
                type: "`$STRING`"
              }
            ]
          }
          method: "DELETE"
          orig: "/emails/{id}"
          parts: [
            "emails"
            "{id}"
          ]
          select: {
            exist: [
              "id"
            ]
          }
          transform: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
      ]
    }
  }



}

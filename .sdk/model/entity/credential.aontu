# Entity: credential

main: kit: entity: credential: {

  alias: field: {}

  fields: [
    {
      name: "aaguid"
      req: false
      type: "`$STRING`"
    }
    {
      name: "attestation_type"
      req: false
      type: "`$STRING`"
    }
    {
      name: "backup_eligible"
      req: false
      type: "`$BOOLEAN`"
    }
    {
      name: "backup_state"
      req: false
      type: "`$BOOLEAN`"
    }
    {
      name: "created_at"
      req: false
      type: "`$STRING`"
    }
    {
      name: "id"
      req: false
      type: "`$STRING`"
    }
    {
      name: "last_used_at"
      req: false
      type: "`$STRING`"
    }
    {
      name: "mfa_only"
      req: false
      type: "`$BOOLEAN`"
    }
    {
      name: "name"
      req: false
      type: "`$STRING`"
    }
    {
      name: "public_key"
      req: false
      type: "`$STRING`"
    }
    {
      name: "transport"

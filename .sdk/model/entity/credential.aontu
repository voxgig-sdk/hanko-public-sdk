      type: "`$ARRAY`"
    }
  ]

  id: {
    field: "id"
    name: "id"
  }

  name: "credential"
  op: {
    list: {
      name: "list"
      points: [
        {
          method: "GET"
          orig: "/webauthn/credentials"
          parts: [
            "webauthn"
            "credentials"
          ]
          transform: {
            req: "`reqdata`"
            res: "`body`"
          }

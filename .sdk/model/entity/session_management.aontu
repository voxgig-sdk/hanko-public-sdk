# Entity: session_management

main: kit: entity: session_management: {

  alias: field: {}

  fields: {
    claims: {
      h: "Claims"
      n: "claims"
      r: true
      sh: "The claims extracted from a JWT."
      t: "`$OBJECT`"
    }
    expiration_time: {
      de: true
      fo: "date-time"
      h: "Expiration Time"
      n: "expiration_time"
      r: false
      sh: "Date-time indicating the expiration of the session."
      t: "`$STRING`"
    }
    idle_expires_at: {
      fo: "date-time"
      h: "Idle Expires At"
      n: "idle_expires_at"
      r: false
      sh: "Timestamp (in UTC) indicating when the session will expire due to inactivity, assuming no further activity occurs before this time."
      t: "`$STRING`"
    }
    is_valid: {
      h: "Is Valid"
      n: "is_valid"
      r: false
      sh: "Indicates whether the session is valid or not"
      t: "`$BOOLEAN`"
    }
    session_token: {
      fo: "JWT"
      h: "Session Token"
      n: "session_token"
      r: true
      sh: "The session token (JWT) to validate"
      t: "`$STRING`"
    }
    user_id: {
      de: true
      fo: "uuid4"
      h: "User Id"
      n: "user_id"
      r: false
      sh: "The ID of the user the session is associated with."
      t: "`$STRING`"
    }
  }

  name: "session_management"
  op: {
    create: {
      name: "create"
      points: [
        {
          bf: [
            "session_token"
          ]
          co: {
            id: "POST /sessions/validate"
            source: "openapi3"
            version: 2
          }
          m: "POST"
          o: "/sessions/validate"
          rs: {
            kind: "json"
            media: "application/json"
          }
          s: [
            {
              lit: "sessions"
            }
            {
              lit: "validate"
            }
          ]
          t: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
      ]
    }
    load: {
      name: "load"
      points: [
        {
          co: {
            id: "GET /sessions/validate"
            source: "openapi3"
            version: 2
          }
          m: "GET"
          o: "/sessions/validate"
          rs: {
            kind: "json"
            media: "application/json"
          }
          s: [
            {
              lit: "sessions"
            }
            {
              lit: "validate"
            }
          ]
          t: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
      ]
    }
  }



}

# Entity: session_management

main: kit: entity: session_management: {

  alias: field: {}

  fields: [
    {
      name: "amr"
      req: false
      type: "`$ARRAY`"
    }
    {
      name: "audience"
      req: false
      type: "`$ARRAY`"
    }
    {
      name: "email"
      req: false
      type: "`$OBJECT`"
    }
    {
      name: "expiration"
      req: true
      type: "`$STRING`"
    }
    {
      name: "issued_at"
      req: false
      type: "`$STRING`"
    }
    {
      name: "issuer"
      req: false
      type: "`$STRING`"
    }
    {
      name: "session_id"
      req: true
      type: "`$STRING`"
    }
    {
      name: "session_token"
      req: true
      type: "`$STRING`"
    }
    {
      name: "subject"
      req: true
      type: "`$ANY`"
    }
  ]

  name: "session_management"
  op: {
    create: {
      name: "create"
      points: [
        {
          method: "POST"
          orig: "/sessions/validate"
          parts: [
            "sessions"
            "validate"
          ]
          transform: {
            req: "`reqdata`"
            res: "`body.claims`"
          }
        }
      ]
    }
    load: {
      name: "load"
      points: [
        {
          method: "GET"
          orig: "/sessions/validate"
          parts: [
            "sessions"
            "validate"
          ]
          transform: {
            req: "`reqdata`"
            res: "`body.claims`"
          }
        }
      ]
    }
  }



}

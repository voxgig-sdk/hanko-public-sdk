# Entity: saml

main: kit: entity: saml: {

  alias: field: {}

  fields: [
    {
      name: "attribute_map"
      req: false
      type: "`$OBJECT`"
    }
    {
      name: "domain"
      req: false
      type: "`$STRING`"
    }
    {
      name: "enabled"
      req: false
      type: "`$BOOLEAN`"
    }
    {
      name: "metadata_url"
      req: false
      type: "`$STRING`"
    }
    {
      name: "name"
      req: false
      type: "`$STRING`"
    }
    {
      name: "skip_email_verification"
      req: false
      type: "`$BOOLEAN`"
    }
  ]

  name: "saml"
  op: {
    create: {
      name: "create"
      points: [
        {
          method: "POST"
          orig: "/saml/callback"
          parts: [
            "saml"
            "callback"
          ]
          select: {
            "$action": "callback"
          }
          transform: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
      ]
    }
    load: {
      name: "load"
      points: [
        {
          args: {
            query: [
              {
                kind: "query"
                name: "cert_only"
                orig: "cert_only"
                reqd: false
                type: "`$BOOLEAN`"
              }
              {
                kind: "query"
                name: "domain"
                orig: "domain"
                reqd: true
                type: "`$STRING`"
              }
            ]
          }
          method: "GET"
          orig: "/saml/metadata"
          parts: [
            "saml"
            "metadata"
          ]
          select: {
            "$action": "metadata"
            exist: [
              "cert_only"
              "domain"
            ]
          }
          transform: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
        {
          args: {
            query: [
              {
                kind: "query"
                name: "domain"
                orig: "domain"
                reqd: true
                type: "`$STRING`"
              }
            ]
          }
          method: "GET"
          orig: "/saml/provider"
          parts: [
            "saml"
            "provider"
          ]
          select: {
            "$action": "provider"
            exist: [
              "domain"
            ]
          }
          transform: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
      ]
    }
  }



}

            id: "POST /webauthn/registration/initialize"
            json: "{\"operationId\":\"webauthnRegInit\",\"parameters\":[],\"protocol\":\"http\",\"responses\":{\"200\":{\"content\":{\"application/json\":{\"schema\":{\"description\":\"Options for credential creation with the WebAuthn API\",\"externalDocs\":{\"url\":\"https://www.w3.org/TR/webauthn-2/#dictionary-makecredentialoptions\"},\"properties\":{\"publicKey\":{\"properties\":{\"attestation\":{\"enum\":[\"none\",\"indirect\",\"direct\",\"enterprise\"],\"example\":\"none\",\"type\":\"string\"},\"authenticatorSelection\":{\"properties\":{\"authenticatorAttachment\":{\"enum\":[\"platform\",\"cross-platform\"],\"example\":\"platform\",\"type\":\"string\"},\"requireResidentKey\":{\"example\":true,\"type\":\"boolean\"},\"residentKey\":{\"enum\":[\"discouraged\",\"preferred\",\"required\"],\"example\":\"preferred\",\"type\":\"string\"},\"userVerification\":{\"enum\":[\"discouraged\",\"preferred\",\"required\"],\"example\":\"required\",\"type\":\"string\"}},\"type\":\"object\"},\"challenge\":{\"example\":\"7qmkJUXR0dOFnsW48evX3qKdCzlGjvvqAAvMDN+KTN0=\",\"format\":\"base64url\",\"type\":\"string\"},\"pubKeyCredParams\":{\"example\":[{\"alg\":-7,\"type\":\"public-key\"}],\"items\":{\"properties\":{\"alg\":{\"type\":\"number\"},\"type\":{\"enum\":[\"public-key\"],\"type\":\"string\"}},\"type\":\"object\"},\"type\":\"array\"},\"rp\":{\"properties\":{\"id\":{\"example\":\"localhost\",\"type\":\"string\"},\"name\":{\"example\":\"Hanko Authentication Service\",\"type\":\"string\"}},\"type\":\"object\"},\"timeout\":{\"example\":60000,\"format\":\"int64\",\"type\":\"integer\"},\"user\":{\"properties\":{\"displayName\":{\"example\":\"user@example.com\",\"type\":\"string\"},\"id\":{\"example\":\"pPQT9rwJRD7gVncsnCDNyN\",\"type\":\"string\"},\"name\":{\"example\":\"user@example.com\",\"type\":\"string\"}},\"type\":\"object\"}},\"type\":\"object\"}},\"type\":\"object\"}}},\"description\":\"Challenge\"},\"400\":{\"content\":{\"application/json\":{\"example\":{\"code\":400,\"message\":\"Bad Request\"},\"schema\":{\"properties\":{\"code\":{\"format\":\"int32\",\"type\":\"integer\"},\"message\":{\"type\":\"string\"}},\"required\":[\"code\",\"message\"],\"type\":\"object\"}}},\"description\":\"Bad Request\"},\"422\":{\"content\":{\"application/json\":{\"example\":{\"code\":422,\"message\":\"Unprocessable Entity\"},\"schema\":{\"properties\":{\"code\":{\"format\":\"int32\",\"type\":\"integer\"},\"message\":{\"type\":\"string\"}},\"required\":[\"code\",\"message\"],\"type\":\"object\"}}},\"description\":\"Unprocessable Entity\"},\"500\":{\"content\":{\"application/json\":{\"example\":{\"code\":500,\"message\":\"Internal Server Error\"},\"schema\":{\"properties\":{\"code\":{\"format\":\"int32\",\"type\":\"integer\"},\"message\":{\"type\":\"string\"}},\"required\":[\"code\",\"message\"],\"type\":\"object\"}}},\"description\":\"Internal server error\"}},\"security\":[{\"CookieAuth\":[]},{\"BearerTokenAuth\":[]}],\"securitySchemes\":{\"BearerTokenAuth\":{\"bearerFormat\":\"JWT\",\"scheme\":\"bearer\",\"type\":\"http\"},\"CookieAuth\":{\"in\":\"cookie\",\"name\":\"hanko\",\"type\":\"apiKey\"}},\"securitySource\":\"operation\"}"
            source: "openapi3"
            version: 1
          }
          method: "POST"

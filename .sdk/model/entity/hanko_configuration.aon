# Entity: hanko_configuration

main: kit: entity: hanko_configuration: {

  alias: field: {}

  fields: [
    {
      name: "account"
      req: false
      short: "Controls the behavior regarding user account."
      type: "`$OBJECT`"
    }
    {
      name: "emails"
      req: false
      short: "Controls the behavior regarding email addresses."
      type: "`$OBJECT`"
    }
    {
      name: "password"
      req: false
      short: "Configuration options concerning passwords"
      type: "`$OBJECT`"
    }
  ]

  name: "hanko_configuration"
  op: {
    load: {
      name: "load"
      points: [
        {
          method: "GET"
          orig: "/.well-known/config"
          segments: [
            {
              lit: ".well-known"
            }
            {
              lit: "config"
            }
          ]
          transform: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
      ]
    }
  }



}

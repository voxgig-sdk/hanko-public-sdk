# Generated from the API definition and overwritten on every build: do not
# edit this file. Put customizations in the guide entry file, which includes
# this one and overrides its defaults:
#   guide.aontu

guide: {
  metrics: count: entity: 7
  metrics: count: path: 9
  metrics: count: method: 10

  entity: json_web_key: {
    path: "/.well-known/jwks.json": {
      op: list: method: *GET
      op: list: transform: res: *("`body.keys`")|top
    }
  }

  entity: organization_management: {
    path: "/organizations/roles/check": {
      op: create: method: *POST
    }
  }

  entity: saml: {
    path: "/saml/callback": {
      action: "callback": {}
      op: create: method: *POST
    }
    path: "/saml/metadata": {
      action: "metadata": {}
      op: load: method: *GET
    }
  }

  entity: session_management: {
    path: "/sessions/validate": {
      op: create: method: *POST
      op: list: method: *GET
    }
  }

  entity: status: {
    path: "/": {
      op: load: method: *GET
    }
  }

  entity: third_party: {
    path: "/thirdparty/callback": {
      op: load: method: *GET
    }
  }

  entity: user_management: {
    path: "/logout": {
      op: create: method: *POST
    }
    path: "/me": {
      op: list: method: *GET
    }
  }

}
# BasicPasswordFlow

main: kit: flow: BasicPasswordFlow:
{
  entity: "password",
  kind: "basic",
  name: "BasicPasswordFlow",
  step: [
    {
      input: {
        ref: "password_ref01"
      }

      op: "create"
    }

    {
      input: {
        ref: "password_ref01",
        srcdatavar: "password_ref01_data",
        suffix: "_up0",
        textfield: "password"
      }

      op: "update",
      spec: [
        {
          apply: "TextFieldMark",
          def: {
            mark: "Mark01-password_ref01"
          }
        }
      ]
    }
  ],
  "key$": "BasicPasswordFlow"
}